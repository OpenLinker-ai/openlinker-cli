# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG GO_VERSION=1.26.4
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm@sha256:b305420a68d0f229d91eb3b3ed9e519fcf2cf5461da4bef997bf927e8c0bfd2b AS go-build
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-mod=readonly GOWORK=off
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY . .
RUN go test ./cmd/openlinker-browser-runtime ./pkg/browserprofile ./pkg/browserprotocol ./pkg/browserruntime
ARG TARGETOS
ARG TARGETARCH
RUN test "${TARGETOS}" = linux \
 && GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" go build -trimpath -ldflags="-s -w" -o /out/openlinker-browser-runtime ./cmd/openlinker-browser-runtime

FROM node:24.4.1-bookworm-slim@sha256:36ae19f59c91f3303c7a648f07493fe14c4bd91320ac8d898416327bacf1bbfa AS engine-build
WORKDIR /src/browser-engine
COPY browser-engine/package.json browser-engine/package-lock.json ./
RUN npm ci --ignore-scripts
COPY browser-engine/tsconfig.json ./
COPY browser-engine/src ./src
RUN npm run lint \
 && npm test \
 && npm prune --omit=dev \
 && npm cache clean --force

FROM mcr.microsoft.com/playwright:v1.61.1-noble@sha256:5b8f294aff9041b7191c34a4bab3ac270157a28774d4b0660e9743297b697e48 AS browser
USER root
RUN install -d -o pwuser -g pwuser -m 0700 /browser-state /browser-tmp \
 && install -d -o pwuser -g pwuser -m 0700 /browser-control \
 && install -d -o root -g root -m 0555 /opt/openlinker/browser-engine
COPY --from=go-build --chown=root:root --chmod=0555 /out/openlinker-browser-runtime /usr/local/bin/openlinker-browser-runtime
COPY --from=engine-build --chown=root:root /src/browser-engine/dist /opt/openlinker/browser-engine/dist
COPY --from=engine-build --chown=root:root /src/browser-engine/node_modules /opt/openlinker/browser-engine/node_modules
COPY --from=engine-build --chown=root:root /src/browser-engine/package.json /opt/openlinker/browser-engine/package.json
ENV HOME=/home/pwuser \
    TMPDIR=/browser-tmp \
    NO_PROXY= \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    OPENLINKER_BROWSER_SOCKET=/browser-control/openlinker.browser.sock
WORKDIR /browser-state
USER pwuser
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/openlinker-browser-runtime"]
LABEL org.opencontainers.image.title="OpenLinker Browser Runtime" \
      org.opencontainers.image.description="Isolated Chromium runtime for the private OpenLinker Browser contract" \
      org.opencontainers.image.source="https://github.com/OpenLinker-ai/openlinker-cli" \
      org.opencontainers.image.licenses="Apache-2.0"
